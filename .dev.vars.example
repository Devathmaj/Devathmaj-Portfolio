# Local only. Run npm run contact:setup to append missing local signing secrets.
# Preserve an existing Turnstile secret. Never copy production keys into examples.
TURNSTILE_SECRET_KEY=replace_with_local_turnstile_secret
CONTACT_SESSION_SECRET=replace_with_independent_random_secret
CONTACT_RATE_LIMIT_SECRET=replace_with_independent_random_secret
RESEND_API_KEY=replace_with_resend_key
CONTACT_FROM_EMAIL="Verified Sender <replace@verified-domain.example>"
CONTACT_TO_EMAIL=replace@recipient.example
CONTACT_ALLOWED_ORIGIN=https://devathmaj.me
CONTACT_ALLOWED_HOSTNAME=devathmaj.me
CONTACT_LOCAL_DEV=true
