# Copy to .dev.vars for `wrangler pages dev`.
# Contact form (functions/api/contact.js)
# Turnstile test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=re_replace_with_your_api_key
# Optional. Defaults: onboarding@resend.dev -> devathmaj@gmail.com
# Until a sending domain is verified, Resend only delivers to the account owner.
# Override the sender with an address on a domain verified in Resend:
# CONTACT_FROM_EMAIL="Portfolio Devathmaj <hello@your-verified-domain.com>"
# CONTACT_TO_EMAIL=devathmaj@gmail.com

# Now playing (functions/tidal.js)
# TIDAL_CLIENT_ID=replace_with_your_client_id
# TIDAL_CLIENT_SECRET=replace_with_your_client_secret
# LAST_FM_USER=replace_with_your_last_fm_user
# LAST_FM_API_KEY=replace_with_your_api_key
