{
  "name": "devathmaj-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal site and portfolio of Devathmaj A Kaliyathan",
  "scripts": {
    "prestart": "node scripts/prepare-build.js --dev",
    "start": "concurrently -k \"sass --no-source-map --watch src/scss:_site/css --style compressed\" \"rollup --config --watch\" \"npx @11ty/eleventy --serve\"",
    "dev": "npm run start",
    "prestart:quiet": "node scripts/prepare-build.js --dev",
    "start:quiet": "concurrently -k \"sass --no-source-map --watch src/scss:_site/css --style compressed\" \"rollup --config --watch\" \"npx @11ty/eleventy --serve --quiet\"",
    "prebuild": "node scripts/prepare-build.js",
    "build": "node -e \"import('node:fs').then(fs => { fs.rmSync('_site/js', { recursive: true, force: true }); fs.rmSync('_site/css', { recursive: true, force: true }); })\" && sass --no-source-map src/scss:_site/css --style compressed && rollup --config && npx @11ty/eleventy",
    "postbuild": "node scripts/generate-assets.js",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('_site', { recursive: true, force: true }))\"",
    "prepreview": "node scripts/prepare-build.js --reuse",
    "preview": "wrangler pages dev _site --port=8788 --ip=127.0.0.1 --compatibility-date=2026-10-30 --do CONTACT_LIMITER=ContactRateLimitShard@portfolio-contact-limiter",
    "contact:setup": "node scripts/setup-contact-local.js",
    "contact:limiter": "wrangler dev --config contact-rate-limiter/wrangler.toml --local --ip=127.0.0.1 --port=8787 --compatibility-date=2026-10-30",
    "test:contact:local": "node scripts/test-contact-local.js",
    "contact:limiter:check": "wrangler deploy --config contact-rate-limiter/wrangler.toml --dry-run --outdir .cache/contact-limiter",
    "social:preview": "node scripts/generate-social-preview.js",
    "test:contact": "node --test tests/contact/*.test.js",
    "deploy": "npm run build && wrangler pages deploy _site",
    "postinstall": "node scripts/patch-deps.js && node scripts/prepare-build.js --dev"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "dotenv": "^16.4.5",
    "rollup": "^4.28.1",
    "rollup-plugin-glsl": "^1.3.0",
    "sharp": "^0.33.5",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^6.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@rollup/plugin-dynamic-import-vars": "^2.1.5",
    "@rollup/plugin-terser": "^0.4.4",
    "@sindresorhus/slugify": "^2.2.1",
    "@unseenco/taxi": "1.8.0",
    "concurrently": "^9.0.1",
    "dedent": "^1.7.0",
    "gsap": "^3.13",
    "jsdom": "^25.0.1",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.2.0",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-prism": "^2.3.0",
    "sass": "^1.80.1",
    "simplex-noise": "^4.0.3",
    "stylelint": "^16.12.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-selector-bem-pattern": "^4.0.1",
    "stylelint-use-logical": "^2.1.2",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
