---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: false
---
<?xml version="1.0" encoding="UTF-8"?>
{%- set siteUrl = "https://devathmaj.me" %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>{{ siteUrl }}/</loc>
    </url>
{%- for entry in collections.page %}
{%- if entry.url != "/now/" and (entry.url | replace("/experience/", "")) == entry.url %}
    <url>
        <loc>{{ siteUrl }}{{ entry.url }}</loc>
    </url>
{%- endif %}
{%- endfor %}
{%- for job in experience %}
    <url>
        <loc>{{ siteUrl }}/experience/{{ job.slug }}/</loc>
    </url>
{%- endfor %}
{%- for project in collections.project %}
{%- if project.url %}
    <url>
        <loc>{{ siteUrl }}{{ project.url }}</loc>
{%- if project.data.publishDate %}
        <lastmod>{{ project.data.publishDate }}</lastmod>
{%- endif %}
    </url>
{%- endif %}
{%- endfor %}
</urlset>
