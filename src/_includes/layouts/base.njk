{% set pageTitle = site.baseTitle %}
{% if title %}
    {% set pageTitle = title + ' | ' + pageTitle %}
{% endif %}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="site-build" content="{{ build.id }}">
    <meta name="site-build-dev" content="{{ 'true' if build.dev else 'false' }}">
    {% if meta.title %}
    <title>{{ meta.title }}</title>
    {% else %}
    <title>{{ pageTitle }}</title>
    {% endif %}
    {% if meta.description %}
    <meta name="description" content="{{ meta.description }}" />
    {% else %}
    <meta name="description" content="Devathmaj's Portfolio — Software Engineering, Backend Development and Full-Stack Applications, with a focus on Python, FastAPI, React and AI-driven solutions." />
    {% endif %}
    
    {% if noindex %}
    <meta name="robots" content="noindex" />
    {% endif %}
    
    {% set canonical = page.url | canonicalUrl %}
    <link rel="canonical" href="https://devathmaj.me{{ canonical }}">
    
    <link rel="icon" href="/meta/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="96x96" href="/meta/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/meta/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/meta/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/meta/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/meta/apple-touch-icon.png" />
    <link rel="me" href="https://github.com/Devathmaj">
    <link rel="me" href="https://linkedin.com/in/devathmaj">
    <link rel="me" href="mailto:devathmaj@gmail.com">
    <link rel="manifest" href="/meta/site.webmanifest" />
    <link rel="mask-icon" href="/meta/safari-pinned-tab.svg" color="#FA3B19" />
    <meta name="msapplication-TileColor" content="#2a2722" />
    <meta name="theme-color" content="#2a2722" />
    <meta name="generator" content="eleventy">

    <meta property="og:url" content="https://devathmaj.me{{ canonical }}">
    <meta property="og:type" content="website">
    {% if meta.title %}
    <meta property="og:title" content="{{ meta.title }}">
    {% else %}
    <meta property="og:title" content="{{ pageTitle }}">
    {% endif %}
    {% if meta.description %}
    <meta property="og:description" content="{{ meta.description }}">
    {% else %}
    <meta property="og:description" content="Devathmaj's Portfolio — Software Engineering, Backend Development and Full-Stack Applications, with a focus on Python, FastAPI, React and AI-driven solutions.">
    {% endif %}
    {% if og %}
        <meta property="og:image" content="{{ og }}">
    {% endif %}

    {% if page.url === '/' %}
        {# The eager, high-priority hero image is the LCP element. Preloading
           exactly the WebP candidate that <picture> will choose removes the
           parser-discovery delay without adding a second download. #}
        <link rel="preload" as="image" type="image/webp" fetchpriority="high"
              href="/img/confessit-800w.webp"
              imagesrcset="/img/confessit-400w.webp 400w, /img/confessit-800w.webp 800w, /img/confessit-1400w.webp 1400w, /img/confessit-1919w.webp 1919w"
              imagesizes="(min-width: 900px) 50vw, (min-width: 600px) 40vw, 60vw">
        <link rel="preload" href="/fonts/manuka-black.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/subset-LouizeDisplay.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/subset-LouizeDisplay-Italic.woff2" as="font" type="font/woff2" crossorigin />
        {# Body and label faces are used in the first viewport. Preloading them
           avoids laying the page out with fallback metrics and then reflowing
           the whole document when the remote fonts arrive. #}
        <link rel="preload" href="/fonts/PPNeueMontreal-Regular.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/PPNeueMontreal-Bold.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/subset-Louize.woff2" as="font" type="font/woff2" crossorigin />
    {% else %}
        <link rel="preload" href="/fonts/subset-Louize.woff2" as="font" type="font/woff2" crossorigin />
    {% endif %}

    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preload" href="/js/rotation-init.js" as="script" fetchpriority="high">
    <noscript>
        <style>
            [data-image-shuffle] picture:first-of-type img {
                opacity: 1;
            }
        </style>
    </noscript>


</head>

<body class="no-js {% if bodyClass %}{{ bodyClass }}{% endif %}">
    {% include 'humanity.njk' %}
    {% renderTemplate "webc", { backLink: backLink, backLinkText: backLinkText } %}
        <page-nav :@back-link="backLink" :@back-link-text="backLinkText"></page-nav>
    {% endrenderTemplate %}
    <div data-taxi class="router-target">
        <div data-taxi-view data-view="{{ canonical }}">

        {{ content | safe }}
        {% renderTemplate "webc", { backLink: backLink, backLinkText: backLinkText, footerLinks: footerLinks } %}
            <page-nav-data :@back-link="backLink" :@back-link-text="backLinkText" :@footer-links="footerLinks"></page-nav-data>
        {% endrenderTemplate %}
        </div>
    </div>
    {% include 'footer.njk' %}
    {% include 'discovery-notice.njk' %}
    {% include 'grid.njk' %}
    <script src="/js/vendor/splitting.min.js"></script>
    <script src="/js/index.js" type="module"></script>
</body>
</html>
