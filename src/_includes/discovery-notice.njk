<dialog class="discovery-notice" id="discovery-notice" data-discovery-notice aria-labelledby="discovery-title" aria-describedby="discovery-description">
    <h2 class="discovery-notice__title" id="discovery-title" data-discovery-title></h2>
    <p class="discovery-notice__description" id="discovery-description" data-discovery-description></p>
    <div class="discovery-notice__discoveries" data-discovery-discoveries hidden>
        <p class="discovery-notice__discoveries-label" data-discovery-discoveries-label></p>
        <ul class="discovery-notice__discoveries-list" data-discovery-discoveries-list></ul>
    </div>
    <div class="discovery-notice__record">
        <span class="discovery-notice__count" data-discovery-count></span>
        <span data-discovery-support></span>
    </div>
    <div class="discovery-notice__progress" role="progressbar" aria-label="Hidden routes unlocked" aria-valuemin="0" aria-valuemax="2" aria-valuenow="0"><span></span></div>
    <button class="discovery-notice__dismiss" type="button">Keep exploring <span aria-hidden="true">→</span></button>
</dialog>
