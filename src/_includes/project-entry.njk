<article class="project-entry">
    <h1 class="project-entry__title">
        {{ projectEntry.data.title }}
    </h1>
    <p class="project-entry__description">
        {{- projectEntry.data.briefAbstract if projectEntry.data.briefAbstract else projectEntry.data.abstract -}}
    </p>
    <dl class="project-entry__meta">
        <div>
            <dt class="visually-hidden">Tags</dt>
            {% if projectEntry.data.categories %}
            <dd>
                {%- for category in projectEntry.data.categories -%}
                    {{ category }}
                    {%- if not loop.last %} | {% endif %}
                {%- endfor -%}
            </dd>
            {% endif %}
        </div>
    </dl>
    {% if projectEntry.content.length > 0 %}
        <a class="project-entry__link with-arrow" href="/projects/{{ projectEntry.data.title | slugify }}">
            <span class="with-underline">Read more
                <span class="visually-hidden">about the {{ projectEntry.data.title }} project</span>
            </span>
        </a>
    {% endif %}
</article>
