{% from 'graphics/record-motifs.njk' import sprig, rack, database %}
<svg viewBox="0 0 560 310" fill="none" aria-hidden="true" focusable="false">
    <g stroke="currentColor" stroke-width="0.7" opacity="0.22">
        <path d="M24 255L266 119L532 209M24 273L266 137L532 227M24 291L266 155L532 245M76 225L329 291M133 193L396 273M190 161L461 255"/>
        <path d="M18 20H42M30 8V32M518 278H542M530 266V290"/>
    </g>
    {% if job.visual.kind == 'distribution' %}
        <g stroke="currentColor" stroke-width="1.3">
            <path d="M72 76H180V142M72 126H154V161M72 176H126V183M72 226H101V205M305 167H355V116H442M307 210H365V240H448"/>
            <path d="M91 76H180V142M323 167H355V116H416" stroke-dasharray="3 5"/>
        </g>
        <g class="experience-system__packets" fill="currentColor" stroke="none">
            <g class="experience-system__route experience-system__route--feed-a">
                <circle class="experience-system__packet" r="2.4"/>
                <circle class="experience-system__packet" r="2.4"/>
            </g>
            <g class="experience-system__route experience-system__route--feed-b">
                <circle class="experience-system__packet" r="2.4"/>
                <circle class="experience-system__packet" r="2.4"/>
            </g>
            <g class="experience-system__route experience-system__route--database">
                <circle class="experience-system__packet" r="2.4"/>
                <circle class="experience-system__packet" r="2.4"/>
            </g>
            <g class="experience-system__route experience-system__route--archive">
                <circle class="experience-system__packet" r="2.4"/>
                <circle class="experience-system__packet" r="2.4"/>
            </g>
        </g>
        {% for role in range(0, job.visual.roleCount) %}
            <g transform="translate({{ 40 + (role % 2) * 32 }} {{ 60 + ((role / 2) | int) * 50 }})" stroke="currentColor" stroke-width="1.3" fill="var(--color-background)">
                <rect x="-13" y="-13" width="26" height="30" rx="3"/>
                <circle cy="-3" r="4"/><path d="M-7 11C-7 2 7 2 7 11"/>
            </g>
        {% endfor %}
        {{ rack(169, 73) }}
        {{ database(399, 53) }}
        <g transform="translate(405 207)" stroke="currentColor" stroke-width="1.4" fill="var(--color-background)">
            <path d="M0 12L32 0L87 16L55 31Z M0 12V49L55 69L87 53V16M55 31V69M16 6L71 24V38L59 43V28"/>
            <path d="M9 37L27 43M9 43L22 48" stroke-width="0.8"/>
        </g>
        <g transform="translate(306 13) rotate(12)">{{ sprig() }}</g>
    {% else %}
        <g stroke="currentColor" stroke-width="1.4" fill="none">
            <path d="M122 150H196M311 150H342V130H368M433 180V192"/>
            <path d="M190 144L196 150L190 156M362 124L368 130L362 136M427 186L433 192L439 186"/>
        </g>
        <g transform="translate(42 78)" fill="var(--color-background)" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
            <path d="M6 132V66C6 24 74 24 74 66V132"/>
            <path d="M0 132H80V144H0Z"/>
            <path d="M28 132V98C28 86 52 86 52 98V132"/>
            <circle cx="40" cy="103" r="6"/>
            <path d="M40 109V122"/>
        </g>
        <g transform="translate(112 74)" fill="var(--color-background)" stroke="currentColor" stroke-width="1.3">
            <circle r="14"/>
            <circle cx="-3" cy="0" r="3.6"/>
            <path d="M0.6 0H10M6 0V4"/>
        </g>
        <g transform="translate(255 150)" fill="var(--color-background)" stroke="currentColor" stroke-width="1.5">
            <circle r="56"/>
            <circle r="47" fill="none" stroke-width="0.8" stroke-dasharray="2 6"/>
            <g fill="none" stroke-width="0.9">
                <path d="M0 -56V-49M0 56V49M-56 0H-49M56 0H49M39.6 -39.6L34.6 -34.6M-39.6 39.6L-34.6 34.6M39.6 39.6L34.6 34.6M-39.6 -39.6L-34.6 -34.6"/>
            </g>
        </g>
        <g class="experience-system__clock-hands" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <path class="experience-system__clock-hand experience-system__clock-hand--hour" d="M255 150L276 163"/>
            <path class="experience-system__clock-hand experience-system__clock-hand--minute" d="M255 150V119"/>
        </g>
        <circle cx="255" cy="150" r="4" fill="currentColor" stroke="none"/>
        <g transform="translate(255 150)" fill="none" stroke="currentColor" stroke-width="1.3">
            <path d="M-64 -40A76 76 0 0 1 64 -40"/>
            <path d="M53 -48L64 -40L62 -53"/>
        </g>
        <g transform="translate(374 92)" fill="var(--color-background)" stroke="currentColor" stroke-width="1.5">
            <rect width="118" height="24" rx="4"/>
            <rect y="32" width="118" height="24" rx="4"/>
            <rect y="64" width="118" height="24" rx="4"/>
            <g fill="currentColor" stroke="none"><circle cx="15" cy="12" r="2.6"/><circle cx="15" cy="44" r="2.6"/><circle cx="15" cy="76" r="2.6"/></g>
            <path d="M30 12H80M30 44H80M30 76H80" stroke-width="0.8"/>
        </g>
        <g transform="translate(494 76)" fill="var(--color-background)" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round">
            <circle r="15"/>
            <path d="M0 7V-6M-5 -1L0 -6L5 -1" fill="none" stroke-linecap="round"/>
        </g>
        <g transform="translate(403 200)" fill="var(--color-background)" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
            <circle cx="30" cy="-5" r="2.5"/>
            <path d="M12 28C18 24 18 16 18 8C18 -6 42 -6 42 8C42 16 42 24 48 28Z"/>
            <path d="M10 28H50" fill="none"/>
            <path d="M25 35C27 40 33 40 35 35" fill="none"/>
        </g>
        <g transform="translate(403 200)" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
            <path d="M58 6A20 20 0 0 1 58 32"/>
            <path d="M66 0A30 30 0 0 1 66 38"/>
        </g>
        <g transform="translate(132 198) rotate(-8) scale(.72)">{{ sprig() }}</g>
    {% endif %}
</svg>
