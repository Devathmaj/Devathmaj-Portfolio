{% from 'graphics/record-motifs.njk' import sprig %}
<svg viewBox="0 0 240 190" fill="none" aria-hidden="true" focusable="false">
    <g transform="translate(11 32) scale(.85)">{{ sprig() }}</g>
    <g transform="translate(229 32) scale(-.85 .85)">{{ sprig() }}</g>
    <g stroke="currentColor" stroke-width="1">
        <circle cx="120" cy="91" r="64"/><circle cx="120" cy="91" r="55" stroke-dasharray="1 5"/>
        {% for certificate in certificates %}
            <g transform="rotate({{ loop.index0 * (360 / total) }} 120 91)">
                <path class="credential-seal__tick" data-certificate-mark="{{ loop.index0 }}" data-active="{{ 'true' if loop.first else 'false' }}" d="M116 8H124V20H116Z"/>
            </g>
        {% endfor %}
        <path d="M81 157C101 181 139 181 159 157M97 166L88 180M143 166L152 180"/>
    </g>
    <text x="120" y="108" text-anchor="middle" class="credential-seal__number" data-certificate-seal-number>{{ certificates[0].number }}</text>
    <text x="120" y="129" text-anchor="middle" class="credential-seal__total">OF {{ totalLabel }} RECORDS</text>
</svg>
