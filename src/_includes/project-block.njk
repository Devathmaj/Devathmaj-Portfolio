{% macro projectBlock(project) %}
{% set prominence = project.data.prominence or 'low' %}
<article class="project-block project-block--{{ prominence }}"{% if project.data.theme and project.data.theme.fill %} style="--project-fill: {{ project.data.theme.fill }};"{% endif %}>
    <dl class="project-block__meta">
        <div>
            <dt class="visually-hidden">Tags</dt>
            <dd>
                {%- for category in project.data.categories -%}
                    {{ category }}{% if not loop.last %} | {% endif %}
                {%- endfor -%}
            </dd>
        </div>
    </dl>
    <h1 class="project-block__title">{{ project.data.title }}</h1>
    <p class="project-block__description">{{ project.data.abstract }}</p>
    <a class="project-block__link with-arrow" href="/projects/{{ project.data.title | slugify }}/">
        <span class="with-underline">View project</span>
    </a>
</article>
{% endmacro %}
