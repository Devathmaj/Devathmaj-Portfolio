---js
{
    tags: ['page'],
    backLink: '/',
    backLinkText: 'Go home',
    title: 'Projects',
    eleventyComputed: {
        footerLinks: (data) => [
            ...data.footerLinks,
            { name: "Projects", url: "/projects/" },
        ],
    }
}
---
<header class="page-header page-header--projects">
    <div class="page-header__inner">
        <h1 class="page-header__title">Projects</h1>
        <div class="page-header__bar" />
    </div>
</header>

<section class="container">
    <div class="projects-block-list">
        {% for projectEntry in collections['project'] | sortedByWorkOrder %}
            {% include 'project-entry.njk' %}
        {% endfor %}
        <span class="list-design-element"></span>
        <span class="list-design-element"></span>
        <span class="list-design-element"></span>
        <span class="list-design-element"></span>
        <span class="list-design-element"><img eleventy:ignore alt="" src="/img/decor/ethernet-link.svg" /></span>
        <span class="list-design-element"></span>
        <span class="list-design-element"></span>
        <span class="list-design-element"></span>
    </div>
</section>
