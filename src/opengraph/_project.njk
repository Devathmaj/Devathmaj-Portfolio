---
pagination:
  data: "collections['hosted project']"
  size: 1
  alias: "project"
layout: "layouts/og.njk"
permalink: "/opengraph/{{ project.url }}"
bodyClass: 'has-barbed-border'
---
<div class="container container--centered">
  <p class="intro intro--centered">A <span class="accent">project</span> from <span class="accent">the portfolio</span></p>
  <h1 class="project-title">{{ project.data.title  }}</h1>
</div>
<div class="tags">{%- for category in project.data.categories -%}{{ category }}{% if not loop.last %} | {% endif %}{%- endfor -%}</div>